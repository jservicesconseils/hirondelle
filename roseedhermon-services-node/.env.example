# Copier en .env (le fichier est lu depuis la racine de roseedhermon-services-node).
# Toutes les valeurs ci-dessous sont les valeurs par défaut : un .env vide fonctionne.

# --- MongoDB (partagé par ms-event et ms-member, comme les deux services Spring) ---
# SPRING_DATA_MONGODB_URI est lu en premier, puis MONGODB_URI.
SPRING_DATA_MONGODB_URI=mongodb://localhost:27017/db_rdh

# --- Ports ---
# 8081 et 8082 sont les ports des services Spring d'origine ; 8080 est la passerelle
# attendue par environment.dev.memberHost côté Angular.
MS_EVENT_PORT=8081
MS_MEMBER_PORT=8082
GATEWAY_PORT=8080

# --- Cibles de la passerelle (utile si les services tournent ailleurs) ---
MS_EVENT_URL=http://localhost:8081
MS_MEMBER_URL=http://localhost:8082

# --- Stockage des fichiers (app.file.* de application.yml) ---
# Chemin relatif = relatif à la racine de roseedhermon-services-node.
# Pour réutiliser les fichiers déjà déposés par le service Java :
#   APP_FILE_UPLOAD_DIR=../roseedhermon-ms-event/uploads/events
APP_FILE_UPLOAD_DIR=uploads/events
APP_FILE_MAX_SIZE=10485760
APP_FILE_ALLOWED_TYPES=image/jpeg,image/jpg,image/png,image/gif,image/webp,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,video/mp4,audio/mpeg
